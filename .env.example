# Aura Trip — backend environment template
# Copy to .env and fill in real values. NEVER commit the real .env.
# (See P0-Security-Remediation.md — all secrets below must be generated fresh.)

# Runtime
NODE_ENV=development
PORT=5000

# Database
database_url=mongodb://127.0.0.1:27017/aura-trip

# Auth — generate long random values; the same jwt_access_secret must also be
# set as JWT_ACCESS_SECRET on the frontend deployment
jwt_access_secret=<long-random-string>
jwt_access_expires_in=1d
jwt_refresh_expires_in=365d
bcrypt_salt_rounds=10

# Seeded admin account
admin_email=
admin_password=
admin_mobile_number=
admin_image=

# Password-reset link target
reset_link_url=

# Payment gateway (aamarpay) — from the provider dashboard
STORE_ID=
SIGNATURE_KEY=
AAMARPAY_URL=
PAYMENT_VERIFY_URL=
BACKEND_LIVE_URL=
FRONTEND_LIVE_URL=
FRONTEND_BASE_URL=

# Optional knobs
# Premium subscription price in BDT (default 1000)
PREMIUM_PRICE=1000
# 0 = off; set 1 when behind exactly one reverse proxy (for per-IP rate limits)
TRUST_PROXY=0

# Media + email
cloudinary_cloud_name=
cloudinary_api_key=
cloudinary_api_secret=

# Email (SMTP) — Gmail is used automatically (smtp.gmail.com:587, no host/port
# vars needed). EMAIL_USER and EMAIL_PASS are BOTH required or all email
# (verification codes, 2FA OTPs, reset links, security notices) fails closed.
#
# EMAIL_PASS must be a 16-character Gmail App Password (Gmail blocks normal
# passwords for SMTP when 2-Step Verification is on):
#   1. https://myaccount.google.com → Security → 2-Step Verification → ON
#   2. Security → App passwords → select "Mail" → name it "Aura Trip"
#   3. Copy the 16-character code (spaces are fine to remove) into EMAIL_PASS
EMAIL_USER=auratrip.support@gmail.com
EMAIL_PASS=

# Official Aura Trip sender identity. The SMTP account (EMAIL_USER) must be
# authorized to send as EMAIL_FROM_ADDRESS (Gmail send-as / Workspace alias);
# if left empty, mail is sent from EMAIL_USER with the support display name.
SUPPORT_EMAIL=auratrip.support@gmail.com
EMAIL_FROM_NAME=Aura Trip Support
EMAIL_FROM_ADDRESS=

# Google OAuth (server-side ID-token verification)
# Create in Google Cloud Console → APIs & Services → Credentials →
# OAuth client ID (Web application). Add authorized redirect URIs for the
# frontend NextAuth callback, e.g. http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Two-factor authentication (TOTP)
# AES-256-GCM key for encrypting authenticator secrets at rest.
# Generate: openssl rand -base64 32   — store in a secret manager, never in git.
TOTP_ENCRYPTION_KEY=
# Optional: label shown in authenticator apps
TOTP_ISSUER=Aura Trip

# Email OTP (alternative 2FA factor) — ALL OPTIONAL, defaults shown.
# Only override for testing or tuned deployments; the OTP HMAC key is
# derived from jwt_access_secret (no extra secret needed).
#EMAIL_OTP_TTL_MS=300000
#EMAIL_OTP_COOLDOWN_MS=60000
#EMAIL_OTP_MAX_SENDS_PER_CHALLENGE=5
#EMAIL_OTP_MAX_SENDS_PER_ACCOUNT_WINDOW=5
#EMAIL_OTP_ACCOUNT_WINDOW_MS=900000
